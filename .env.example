# Copy to .env and fill in.

# Required for the cognition layer. Without it, /api/chat returns canned replies.
ANTHROPIC_API_KEY=

# Optional — defaults shown.
SWEETIE_HOST=127.0.0.1
SWEETIE_PORT=8000
SWEETIE_MODEL=claude-sonnet-4-5

# Bridge selection. 'sim' (default) runs the kinematic simulator with the
# default M5 scene. 'real' connects to a Unitree Go2 over DDS — requires
# `pip install -e .[real]` and a Go2 on the network.
SWEETIE_BRIDGE=sim
SWEETIE_NETWORK_INTERFACE=eth0
SWEETIE_DDS_DOMAIN=0
